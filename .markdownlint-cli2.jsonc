{
  // Human-maintained Markdown only; frozen validation reports are evidence.
  "globs": [
    "*.md",
    "docs/**/*.md",
    "analysis/*.md",
    "tests/**/*.md"
  ],
  "ignores": [
    "target/**",
    "**/node_modules/**",
    "reports/**",
    "**/source-snapshot/**"
  ],
  "config": {
    "default": true,
    "MD013": {
      "line_length": 80,
      "code_blocks": false,
      "tables": false
    },
    "MD060": {
      "style": "compact"
    }
  }
}
